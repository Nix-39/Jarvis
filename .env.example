# Jarvis configuration template.
# Copy to .env (copy .env.example .env) and adjust. Never commit .env.

# Environment
ENVIRONMENT=development

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Reasoning mode for models that support it (true = slower but deeper answers)
OLLAMA_THINK=false

# Max seconds per agent step before the Planner retries
AGENT_TIMEOUT_SECONDS=120

# Long-term memory relevance cutoff (cosine distance, lower = stricter)
VECTOR_MAX_DISTANCE=0.55

# Logging
LOG_LEVEL=INFO

# Context window for chat requests (tokens)
OLLAMA_NUM_CTX=16384

# Web search via self-hosted SearXNG (see docker/searxng)
WEB_SEARCH_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8888
WEB_MAX_RESULTS=5
# Top pages read in full (0 = snippets only)
WEB_FETCH_PAGES=2
WEB_TIMEOUT_SECONDS=8

# Reminder scheduler (runs inside Jarvis Core)
SCHEDULER_POLL_SECONDS=30

# Jarvis Core local API (always bound to 127.0.0.1)
JARVIS_API_PORT=8765
# Seconds to wait for Ollama at login before starting anyway
OLLAMA_STARTUP_WAIT_SECONDS=300

# Desktop interface: global hotkey that brings up the Yggdrasil window
DESKTOP_HOTKEY=ctrl+alt+j

# Encrypted nightly backup of data/ to another disk (AES-256-GCM, key from the passphrase).
# BACKUP_DIR empty = off. Use at least 12 characters in the passphrase and write it down
# somewhere outside the computer - without it a backup can never be opened.
BACKUP_DIR=
BACKUP_PASSPHRASE=
BACKUP_TIME=03:00
BACKUP_KEEP=14

# Sports: live SHL scores (optional). Free key from https://dashboard.api-football.com
# (API-Sports, free plan 100 requests/day - Jarvis uses at most 90, only while an SHL game is on).
# Empty = SHL results arrive after the games (TheSportsDB). Keep the key secret.
API_SPORTS_KEY=

# Voice: talk to Nexus ("Hej Nexus" or push to talk) and hear her answer - all local.
# KB-Whisper (Swedish) for listening, Piper for speaking. Models download once into models/.
VOICE_ENABLED=true
VOICE_STT_MODEL=KBLab/kb-whisper-large
VOICE_STT_CPU_MODEL=KBLab/kb-whisper-small
VOICE_WAKE_MODEL=KBLab/kb-whisper-base
# auto = GPU if CUDA works (checked safely first), otherwise CPU
VOICE_DEVICE=auto
# Microphone (empty = Windows default). List devices: python -m services.speech_service --devices
VOICE_INPUT_DEVICE=
# How loud speech must be to count (RMS level). Lower it (e.g. 0.004) if a quiet
# microphone is not picked up; "python -m services.speech_service --mic-test" suggests a value.
VOICE_MIC_LEVEL=0.006
VOICE_HOTKEY=ctrl+alt+space

# Notifications
NOTIFY_WINDOWS=true
# Private Telegram bot: chat with Jarvis and get reminders on the phone (optional).
# Token from @BotFather (keep secret). Leave the chat id empty, start Jarvis Core,
# send /start to the bot and it replies with your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Messages older than this (sent while Jarvis was off) are not executed
TELEGRAM_MAX_MESSAGE_AGE_MINUTES=10
TELEGRAM_STARTUP_MESSAGE=true
