# Jarvis configuration template.
# Copy to .env (copy .env.example .env) and adjust. Never commit .env.

# Environment
ENVIRONMENT=development

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Reasoning mode for models that support it (true = slower but deeper answers)
OLLAMA_THINK=false

# Max seconds per agent step before the Planner retries
AGENT_TIMEOUT_SECONDS=120

# Long-term memory relevance cutoff (cosine distance, lower = stricter)
VECTOR_MAX_DISTANCE=0.55

# Logging
LOG_LEVEL=INFO

# Context window for chat requests (tokens)
OLLAMA_NUM_CTX=16384

# Web search via self-hosted SearXNG (see docker/searxng)
WEB_SEARCH_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8888
WEB_MAX_RESULTS=5
# Top pages read in full (0 = snippets only)
WEB_FETCH_PAGES=2
WEB_TIMEOUT_SECONDS=8

# Background scheduler
SCHEDULER_POLL_SECONDS=30

# Notifications
NOTIFY_WINDOWS=true
# Private Telegram bot for phone notifications (optional, keep secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
